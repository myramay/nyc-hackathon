# Photon Spectrum (TypeScript iMessage agent)
PROJECT_ID=
PROJECT_SECRET=
# Gemini (extraction + translation). Model name: check ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# MongoDB Atlas (scanner + web)
MONGODB_URI=
# jev-ultrafast browser agent (optional; falls back to plain HTTP fetch)
JEV_DIR=
# OpenJev (TypeSafe-compatible API; TypeSafe's own API is paused). Free key at codiv.ai
TYPESAFE_BASE_URL=https://api.codiv.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=openjev-latest
JEV_TIMEOUT_MS=45000
