# Photon Spectrum (TypeScript iMessage agent)
PROJECT_ID=
PROJECT_SECRET=
# Gemini (extraction + translation). Model name: check ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# MongoDB Atlas (scanner + web)
MONGODB_URI=
# jev-ultrafast browser agent (optional; falls back to plain HTTP fetch)
# JEV_DIR=/absolute/path/to/jev-ultrafast   (that folder's own .env holds TYPESAFE_API_KEY + TEXT_MODEL_API_KEY)
JEV_DIR=
JEV_TIMEOUT_MS=45000
